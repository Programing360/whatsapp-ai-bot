# Meta Facebook Page Access Token
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Meta Webhook Verify Token (Custom secret string you set in Facebook App Dashboard & Railway)
VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection URI
MONGODB_URI=your_mongodb_connection_uri_here

# Optional: Groq Model ID (Default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
